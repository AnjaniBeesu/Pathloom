# Public production origin used for canonical, Open Graph, sitemap, and OAuth callback URLs.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Auth.js / GitHub OAuth
NEXTAUTH_URL=https://your-production-domain.example
NEXTAUTH_SECRET=generate-a-long-random-secret
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# Supabase (Phase 2–5 durable data path)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scheduled sync identity (provided by the managed runtime in production)
MANUS_PROJECT_ID=your-manus-project-id
MANUS_JWT_SECRET=provided-at-runtime
MANUS_OAUTH_API_URL=https://api.manus.im

# Legacy/manual scheduler and optional rewrite placeholders
CRON_SECRET=
GEMINI_API_KEY=
